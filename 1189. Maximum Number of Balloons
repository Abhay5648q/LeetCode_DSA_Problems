class Solution {
    public int maxNumberOfBalloons(String text) {
     char arr[]=text.toCharArray();
     int ans=0;
     
      while(true){
         String target="balloon";
      for(char ch:target.toCharArray()){
        boolean found=false;
        for(int i=0;i<arr.length;i++){
            if(ch==arr[i]){
                found=true;
                arr[i]='#';
                break;
            }
        }
        if(!found){
            return ans;
        }
        
      }
      ans++;
      }
     
    }
}
