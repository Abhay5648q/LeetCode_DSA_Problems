class Solution {
    public int missingMultiple(int[] nums, int k) {
        HashMap<Integer,Integer>map=new HashMap<>();
        for(int num:nums){
            map.put(num,map.getOrDefault(num,0)+1);
        }
        int a=k;
        int ans=0;
        while(true){
            if(!map.containsKey(a)){
                ans=a;
                break;
            }
            a+=k;
        }
        return ans;
    }
}
