class Solution {
    public int smallestNumber(int n, int t) {   
      int val=n;
      int num=n;  
       while(true){
        int product=1;
         while(num>0){
        int digit=num%10;
        product*=digit;
        num/=10;
       }
       if(product%t!=0){
        val++;
        num=val;
       }
       else  {
            
        break;
       }
       }
    return val;
  }
}
