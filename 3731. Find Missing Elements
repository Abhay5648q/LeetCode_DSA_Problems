class Solution {
    public List<Integer> findMissingElements(int[] nums) {
      Arrays.sort(nums);
      List<Integer>list=new ArrayList<>();
      int currElement=nums[0];
      for(int i=0;i<nums.length;currElement++,i++){
        if(currElement<nums[i]){
            list.add(currElement);
            i--;
        }
      }
      return list;
    }
}
